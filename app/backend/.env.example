# Copy to .env and fill in. Never commit the real .env.

# Required: any long random string (e.g. `openssl rand -hex 32`)
SECRET_KEY=change-me
# Optional: encrypts API keys saved on the Settings page. Must be a Fernet key:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave empty to derive one from SECRET_KEY.
SECRETS_KEY=
ENV=dev

# First admin login, created on first boot
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-too

# Optional: load a few fictional sample leads
SEED_SAMPLE_LEADS=false

# Database (default: ./mpower_leadgen.db)
# DATABASE_URL=sqlite+aiosqlite:///./mpower_leadgen.db

# Outbound email (invites, password reset); leave off in dev
EMAIL_ENABLED=false
# RESEND_API_KEY=
# EMAIL_FROM=
APP_BASE_URL=http://localhost:3030
APP_BRAND_NAME=mPower Lead-Gen

# Optional: third-party keys (or enter them on the Settings page)
# APIFY_API_KEY=
# APOLLO_API_KEY=
# INSTANTLY_API_KEY=
# MILLIONVERIFIER_API_KEY=
# ANTHROPIC_API_KEY=
